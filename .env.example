# Frontend environment variables for My Space (Vite)
# Copy this file to `.env.local` for local development.
# Do NOT commit real secrets or production tokens.

# Primary fast backend: Cloudflare Worker + Turso API URL
# Example: https://my-space-api.<your-subdomain>.workers.dev
VITE_API_URL=

# Optional legacy fallback / media & import bridge: Google Apps Script Web App URL
# Example: https://script.google.com/macros/s/<deployment-id>/exec
VITE_GOOGLE_SCRIPT_URL=
